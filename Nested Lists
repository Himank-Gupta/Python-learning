if __name__ == '__main__':
    records = []
    
    # Read the number of students and their details
    for _ in range(int(input())):
        name = input()
        score = float(input())
        records.append([name, score])
        
    # Extract unique scores, sort them, and get the second lowest score
    scores = sorted(list(set([record[1] for record in records])))
    second_lowest = scores[1]
    
    # Filter and sort the names of students with the second lowest score
    names = sorted([record[0] for record in records if record[1] == second_lowest])
    
    # Print each name on a new line
    for name in names:
        print(name)
